{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asdg:proposed:installation-ownership:1",
  "title": "Proposed deterministic ASDG installation ownership receipt",
  "description": "Schema validation establishes shape only. Semantic validation must enforce catalog scope, selected client, source/target binding, unique normalized path and selector, digest computation and provenance. No approval or authenticity is inferred. No timestamp or final plan token appears in this deterministic payload.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "asdg-installation-ownership"
    },
    "evidence_status": {
      "const": "LOCAL_UNAUTHENTICATED_EVIDENCE"
    },
    "catalog_schema_version": {
      "const": 2
    },
    "catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "plan_basis_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          ]
        },
        "package_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "commit",
        "package_sha256",
        "manifest_sha256"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "pattern": "^/"
        },
        "git_common_dir": {
          "type": "string",
          "pattern": "^/"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "root",
        "git_common_dir",
        "project_id",
        "binding_sha256"
      ]
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "codex",
          "claude"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "exact_plan_apply",
            "reviewed_legacy_adoption"
          ]
        },
        "inventory_basis_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "method",
        "inventory_basis_sha256"
      ]
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "evidence_status",
    "catalog_schema_version",
    "catalog_sha256",
    "plan_basis_sha256",
    "source",
    "target",
    "clients",
    "provenance",
    "entries"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*(?:^|/)\\.git(/|$))(?!.*[:\\\\*?\\[\\]\\u0000-\\u001f])(?!.*//)(?!.*\\/$).+$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "original_state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "const": false
            }
          },
          "required": [
            "present"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "const": true
            },
            "value": {},
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "present",
            "value",
            "sha256"
          ]
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "enum": [
            "distribution",
            "codex-skills",
            "codex-roles",
            "claude-skills",
            "claude-mods",
            "bootstrap",
            "claude-bridge",
            "ignore",
            "codex-config",
            "codex-hooks"
          ]
        },
        "client": {
          "enum": [
            "shared",
            "codex",
            "claude"
          ]
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "installed_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generator": {
          "$ref": "#/$defs/generator"
        },
        "ownership_kind": {
          "enum": [
            "whole_file",
            "marked_block",
            "toml_key",
            "json_entry"
          ]
        },
        "selector": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "string",
                  "minLength": 1
                },
                "end": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "start",
                "end"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key_path": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "key_path"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "array_pointer": {
                  "type": "string",
                  "pattern": "^/"
                },
                "identity_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "array_pointer",
                "identity_sha256"
              ]
            }
          ]
        },
        "original": {
          "$ref": "#/$defs/original_state"
        }
      },
      "required": [
        "entity_id",
        "client",
        "path",
        "installed_sha256",
        "generator",
        "ownership_kind"
      ],
      "oneOf": [
        {
          "properties": {
            "ownership_kind": {
              "const": "whole_file"
            },
            "entity_id": {
              "enum": [
                "distribution",
                "codex-skills",
                "codex-roles",
                "claude-skills",
                "claude-mods"
              ]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "selector"
                ]
              },
              {
                "required": [
                  "original"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "ownership_kind": {
              "const": "marked_block"
            },
            "entity_id": {
              "enum": [
                "bootstrap",
                "claude-bridge",
                "ignore"
              ]
            },
            "selector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "string",
                  "minLength": 1
                },
                "end": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "start",
                "end"
              ]
            }
          },
          "required": [
            "selector",
            "original"
          ]
        },
        {
          "properties": {
            "ownership_kind": {
              "const": "toml_key"
            },
            "entity_id": {
              "enum": [
                "codex-config"
              ]
            },
            "selector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key_path": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "key_path"
              ]
            }
          },
          "required": [
            "selector",
            "original"
          ]
        },
        {
          "properties": {
            "ownership_kind": {
              "const": "json_entry"
            },
            "entity_id": {
              "enum": [
                "codex-hooks"
              ]
            },
            "selector": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "array_pointer": {
                  "type": "string",
                  "pattern": "^/"
                },
                "identity_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "array_pointer",
                "identity_sha256"
              ]
            }
          },
          "required": [
            "selector",
            "original"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "entity_id": {
                "enum": [
                  "distribution",
                  "bootstrap",
                  "ignore"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "client": {
                "const": "shared"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity_id": {
                "enum": [
                  "codex-skills",
                  "codex-roles",
                  "codex-config",
                  "codex-hooks"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "client": {
                "const": "codex"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity_id": {
                "enum": [
                  "claude-skills",
                  "claude-mods",
                  "claude-bridge"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "client": {
                "const": "claude"
              }
            }
          }
        }
      ]
    }
  }
}
